<UserControl x:Class="TeachFlex.Views.SubjectSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <Style x:Key="SubjectLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>
        </Style>

        <Style x:Key="SubjectTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="11,7"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Subject Setup"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock
                        Text="Manage subjects for Grade 1 to Grade 12."
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="13"
                        Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="110"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Subject editor -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18">

                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Subject Information"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock
                                Text="Select a subject below to edit it, or click New Subject."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="11"
                                Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="＋ New Subject"
                                Command="{Binding NewSubjectCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="135"/>
                    </Grid>

                    <!-- Grade and subject name -->
                    <Grid Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Grade Level *"
                                       Style="{StaticResource SubjectLabelStyle}"/>

                            <ComboBox ItemsSource="{Binding GradeLevels}"
                                      SelectedItem="{Binding SelectedGradeLevel}"
                                      Height="42"
                                      Padding="10,7"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Subject Name *"
                                       Style="{StaticResource SubjectLabelStyle}"/>

                            <TextBox Text="{Binding SubjectName,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SubjectTextBoxStyle}"
                                     MaxLength="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Display Order"
                                       Style="{StaticResource SubjectLabelStyle}"/>

                            <TextBox Text="{Binding DisplayOrder,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SubjectTextBoxStyle}"
                                     HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Learning area -->
                    <StackPanel Margin="0,16,0,0">

                        <TextBlock Text="Learning Area"
                                   Style="{StaticResource SubjectLabelStyle}"/>

                        <TextBox Text="{Binding LearningArea,
                                          UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SubjectTextBoxStyle}"
                                 MaxLength="150"/>
                    </StackPanel>

                    <!-- Grade 7-10 SF9 options -->
                    <Border Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,18,0,0">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJuniorHigh}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="Grade 7-10 ECR and SF9 Options"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                            <TextBlock
                                Text="Use these options for additional subjects only. Prescribed learning areas stay included automatically."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Margin="0,4,0,12"/>

                            <CheckBox Content="Include this additional subject in SF9"
                                      IsChecked="{Binding IncludeInSf9}"
                                      IsEnabled="{Binding CanConfigureSf9Options}"
                                      FontSize="12"
                                      Margin="0,0,0,9"/>

                            <CheckBox Content="Include this subject in the General Average"
                                      IsChecked="{Binding IncludeInGeneralAverage}"
                                      IsEnabled="{Binding CanConfigureSf9Options}"
                                      FontSize="12"/>

                            <TextBlock
                                Text="The General Average option automatically includes the subject in SF9."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="10"
                                Margin="22,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Senior High options -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,18,0,0">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeniorHigh}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="Senior High School Options"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                            <TextBlock
                                Text="Select the classification and Track/Strand that will use this subject."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="11"
                                Margin="0,4,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Subject Category"
                                               Style="{StaticResource SubjectLabelStyle}"/>

                                    <ComboBox
                                        ItemsSource="{Binding SubjectCategories}"
                                        SelectedItem="{Binding SubjectCategory}"
                                        Height="42"
                                        Padding="10,7"
                                        FontSize="13"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Track / Strand"
                                               Style="{StaticResource SubjectLabelStyle}"/>

                                    <ComboBox
                                        ItemsSource="{Binding TrackStrandOptions}"
                                        SelectedItem="{Binding TrackStrand}"
                                        Height="42"
                                        Padding="10,7"
                                        FontSize="13"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Margin="0,22,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Deactivate Subject"
                                Command="{Binding DeactivateSubjectCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="150"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Save Subject"
                                Command="{Binding SaveSubjectCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="135"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Subject list -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,12">

                <StackPanel>

                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Subject Records"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding SelectedGradeLevel,
                                    StringFormat=Active subjects for {0}}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="11"
                                Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#F0FDF4"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,6"
                                VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding Subjects.Count,
                                    StringFormat={}{0} SUBJECT(S)}"
                                Foreground="#166534"
                                FontSize="10"
                                FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubject}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="42"
                              ColumnHeaderHeight="40"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              Background="White"
                              AlternatingRowBackground="#F8FAFC">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Order"
                                Binding="{Binding DisplayOrder}"
                                Width="75"/>

                            <DataGridTextColumn
                                Header="Subject Name"
                                Binding="{Binding SubjectName}"
                                Width="1.7*"/>

                            <DataGridTextColumn
                                Header="Learning Area"
                                Binding="{Binding LearningArea}"
                                Width="1.3*"/>

                            <DataGridTextColumn
                                Header="Category"
                                Binding="{Binding SubjectCategory}"
                                Width="1.3*"/>

                            <DataGridTextColumn
                                Header="Track / Strand"
                                Binding="{Binding TrackStrand}"
                                Width="1.2*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

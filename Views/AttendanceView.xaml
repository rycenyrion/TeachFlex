<UserControl x:Class="TeachFlex.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="AttendanceStatusButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PresentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AttendanceStatusButtonStyle}">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="Foreground" Value="#15803D"/>
            <Setter Property="BorderBrush" Value="#86EFAC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AttendanceStatus}"
                             Value="Present">
                    <Setter Property="Background" Value="#16A34A"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AbsentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AttendanceStatusButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AttendanceStatus}"
                             Value="Absent">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LateButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AttendanceStatusButtonStyle}">
            <Setter Property="Background" Value="#FFEDD5"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AttendanceStatus}"
                             Value="Late">
                    <Setter Property="Background" Value="#EA580C"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExcusedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AttendanceStatusButtonStyle}">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AttendanceStatus}"
                             Value="Excused">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Attendance Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <TextBlock Text="Record daily attendance and prepare official monthly SF2 data."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="110"
                        VerticalAlignment="Center"/>
            </Grid>

            <TabControl Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13">

                <TabItem Header="Daily Attendance">
                    <StackPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Daily Attendance Setup"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="17"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Select the class, date, and status of the school day."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Class *" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                        <ComboBox ItemsSource="{Binding Classes}"
                                                  SelectedItem="{Binding SelectedClass}"
                                                  DisplayMemberPath="DisplayName"
                                                  Height="42" Padding="10,7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Date *" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                        <DatePicker SelectedDate="{Binding SelectedDate}"
                                                    Height="42"/>
                                    </StackPanel>
                                    <Button Grid.Column="4"
                                            Content="Today"
                                            Command="{Binding TodayCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="42"
                                            MinWidth="75"
                                            VerticalAlignment="Bottom"/>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Day Status *" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                        <ComboBox ItemsSource="{Binding DayStatusOptions}"
                                                  SelectedItem="{Binding DayStatus}"
                                                  Height="42" Padding="10,7"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Reason / Description" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <TextBox Text="{Binding DayDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Height="29" Padding="10,7" MaxLength="250"/>
                                </StackPanel>

                                <Border Background="#FEF3C7" BorderBrush="#FCD34D"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12" Margin="0,14,0,0" Height="42">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRecordLearnerAttendance}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Learner attendance is disabled because this is not a regular or make-up class day."
                                               Foreground="#92400E" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16" Height="113">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="0,0,10,23">
                                <StackPanel>
                                    <TextBlock Text="TOTAL" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalLearners}" FontSize="25" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,23">
                                <StackPanel>
                                    <TextBlock Text="PRESENT" FontWeight="Bold" Foreground="#15803D"/>
                                    <TextBlock Text="{Binding PresentCount}" FontSize="25" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="10,0,0,23">
                                <StackPanel>
                                    <TextBlock Text="ABSENT" FontWeight="Bold" Foreground="#B91C1C"/>
                                    <TextBlock Text="{Binding AbsentCount}" FontSize="25" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource CardStyle}" Grid.ColumnSpan="3" Margin="10,0,10,23">
                                <StackPanel>
                                    <TextBlock Text="LATE" FontWeight="Bold" Foreground="#C2410C"/>
                                    <TextBlock Text="{Binding LateCount}" FontSize="25" FontWeight="Bold" Foreground="#EA580C"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="8" Style="{StaticResource CardStyle}" Margin="0,0,0,23">
                                <StackPanel>
                                    <TextBlock Text="EXCUSED" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    <TextBlock Text="{Binding ExcusedCount}" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}"
        Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Learner Attendance" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Mark All Present" Command="{Binding MarkAllPresentCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearAttendanceCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding LearnerRows}"
          IsEnabled="{Binding CanRecordLearnerAttendance}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          MinHeight="320"
          MaxHeight="520"
          RowHeight="54"
          ColumnHeaderHeight="40"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          BorderBrush="{StaticResource BorderBrush}"
BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="42"/>
                                        <DataGridTextColumn Header="Learner" Binding="{Binding LearnerName}" IsReadOnly="True" Width="1.4*"/>
                                        <DataGridTextColumn Header="Sex" Binding="{Binding Sex}" IsReadOnly="True" Width="70"/>
                                        <DataGridTemplateColumn Header="Attendance Status" Width="380">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Present" Command="{Binding DataContext.MarkPresentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PresentButtonStyle}"/>
                                                        <Button Content="Absent" Command="{Binding DataContext.MarkAbsentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AbsentButtonStyle}"/>
                                                        <Button Content="Late" Command="{Binding DataContext.MarkLateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource LateButtonStyle}"/>
                                                        <Button Content="Excused" Command="{Binding DataContext.MarkExcusedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ExcusedButtonStyle}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Remarks" Width="1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attendance is saved per class and date." Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Save Attendance" Command="{Binding SaveAttendanceCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="155"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Monthly Summary">
                    <StackPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Class" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" DisplayMemberPath="DisplayName" Height="42" Padding="10,7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Month" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <DatePicker SelectedDate="{Binding SelectedMonth}" Height="42"/>
                                </StackPanel>
                                <Button Grid.Column="4" Content="Load Monthly Summary" Command="{Binding LoadMonthlySummaryCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="165" Height="42" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="CLASS DAYS" Foreground="#64748B" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MonthlyClassDays}" FontSize="25" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="12,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="MALE LEARNERS" Foreground="#1D4ED8" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MonthlyMaleLearners}" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="12,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="FEMALE LEARNERS" Foreground="#9333EA" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MonthlyFemaleLearners}" FontSize="25" FontWeight="Bold" Foreground="#A855F7"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Monthly Attendance Summary" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedMonthText}" Foreground="#64748B" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="11,6">
                                        <TextBlock Text="{Binding MonthlyRows.Count, StringFormat={}{0} LEARNER(S)}" Foreground="#166534" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <DataGrid ItemsSource="{Binding MonthlyRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="42" ColumnHeaderHeight="40" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <DataGrid.Columns>

                                        <DataGridTextColumn
        Header="#"
        Binding="{Binding Number}"
        Width="0.4*"/>

                                        <DataGridTextColumn
        Header="Learner"
        Binding="{Binding LearnerName}"
        Width="1.5*"/>

                                        <DataGridTextColumn
        Header="Sex"
        Binding="{Binding Sex}"
        Width="0.4*"/>

                                        <DataGridTextColumn
        Header="Class Days"
        Binding="{Binding TotalClassDays}"
        Width="0.5*"/>

                                        <DataGridTextColumn
        Header="Present"
        Binding="{Binding PresentDays}"
        Width="0.5*"/>

                                        <DataGridTextColumn
        Header="Absent"
        Binding="{Binding AbsentDays}"
        Width="0.5*"/>

                                        <DataGridTextColumn
        Header="Late"
        Binding="{Binding LateDays}"
        Width="0.5*"/>

                                        <DataGridTextColumn
        Header="Excused"
        Binding="{Binding ExcusedDays}"
        Width="0.5*"/>

                                        <DataGridTextColumn
        Header="Rate"
        Binding="{Binding AttendanceRateText}"
        Width="0.5*"/>

                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Official template outputs will use this monthly data." Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
        Grid.ColumnSpan="3"
        Content="Prepare and Open Official SF2"
        Command="{Binding PrepareOfficialSF2Command}"
        Style="{StaticResource PrimaryButtonStyle}"
        MinWidth="230"
        HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>

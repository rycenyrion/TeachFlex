<UserControl x:Class="TeachFlex.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">

                <TextBlock Text="Backup &amp; Restore"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Protect the complete TeachFlex database and restore previous records safely."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>
                        <Border Width="52"
                                Height="52"
                                Background="#E9F7EE"
                                CornerRadius="13"
                                HorizontalAlignment="Left">

                            <TextBlock Text="↓"
                                       Foreground="#166534"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Create Database Backup"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,16,0,0"/>

                        <TextBlock Text="Save a complete and consistent copy of school years, classes, learners, attendance, grades, and settings."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,20"/>

                        <Button Content="Create Backup"
                                Command="{Binding CreateBackupCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="44"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>
                        <Border Width="52"
                                Height="52"
                                Background="#FFF4E5"
                                CornerRadius="13"
                                HorizontalAlignment="Left">

                            <TextBlock Text="↻"
                                       Foreground="#B45309"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Restore Database Backup"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,16,0,0"/>

                        <TextBlock Text="Validate and restore a previous TeachFlex backup. A safety copy of the current database is created first."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,20"/>

                        <Button Content="Select Backup and Restore"
                                Command="{Binding RestoreBackupCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="44"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}">

                <StackPanel>
                    <TextBlock Text="Database Information"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="17"
                               FontWeight="Bold"/>

                    <TextBlock Text="Current database"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,15,0,4"/>

                    <TextBlock Text="{Binding DatabaseLocation}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Last backup"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,13,0,4"/>

                    <TextBlock Text="{Binding LastBackupPath}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,16,0,0">

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#1D4ED8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

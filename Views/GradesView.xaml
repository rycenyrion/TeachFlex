<UserControl x:Class="TeachFlex.Views.GradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Heading -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Grades"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Review consolidated learner grades from Term 1, Term 2, and Term 3."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="9"
                        Padding="14,9"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding SchoolYearText}"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="11"
                               FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- Selection card -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}">

                <StackPanel>
                    <TextBlock Text="Grade Selection"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="Select a class to review saved ECR, ECD, or PACE records."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,4,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Class"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7"/>

                            <ComboBox ItemsSource="{Binding Classes}"
                                      SelectedItem="{Binding SelectedClass}"
                                      DisplayMemberPath="DisplayName"
                                      Height="43"
                                      MinWidth="190"
                                      Padding="10,7"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKindergartenClass}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Subject"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7"/>

                            <ComboBox ItemsSource="{Binding Subjects}"
                                      SelectedItem="{Binding SelectedSubject}"
                                      DisplayMemberPath="SubjectName"
                                      Height="43"
                                      MinWidth="190"
                                      Padding="10,7"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="4"
                                Content="Load Records"
                                Command="{Binding LoadGradesCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="130"
                                Height="43"
                                VerticalAlignment="Bottom"/>

                        <Button Grid.Column="6"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="100"
                                Height="43"
                                VerticalAlignment="Bottom"/>
                    </Grid>

                    <Border Background="#FFF7D6"
                            BorderBrush="#F3D878"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,16,0,0">

                        <TextBlock Text="{Binding SelectionNote}"
                                   Foreground="#7A5A00"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Summary cards -->
            <Grid Grid.Row="2"
                  Margin="0,18,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL LEARNERS"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding VisibleLearnerCount}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="COMPLETE"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding VisibleCompleteCount}"
                                   Foreground="#2563EB"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ThirdCardTitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ThirdCardValue}"
                                   Foreground="#16A34A"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDescriptiveClass}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="NEEDS SUPPORT"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding LearnersNeedingSupport}"
                                   Foreground="#DC2626"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDescriptiveClass}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="CLASS AVERAGE"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ClassAverageText}"
                                   Foreground="#D97706"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Grade table -->
            <Border Grid.Row="3"
                    Style="{StaticResource CardStyle}"
                    Margin="0,18,0,12">

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SummaryTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#F1F5F9"
                                CornerRadius="8"
                                Padding="12,7"
                                VerticalAlignment="Center">

                            <TextBlock Text="Read-only • Saved records"
                                       Foreground="#475569"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <DataGrid ItemsSource="{Binding GradeRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              AlternationCount="2"
                              RowHeight="40"
                              ColumnHeaderHeight="42"
                              MinHeight="360"
                              FontSize="11">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDescriptiveClass}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Number}"
                                                Width="45"/>

                            <DataGridTextColumn Header="Learner Name"
                                                Binding="{Binding LearnerName}"
                                                Width="2.3*"/>

                            <DataGridTextColumn Header="Sex"
                                                Binding="{Binding Sex}"
                                                Width="0.7*"/>

                            <DataGridTextColumn Header="Term 1"
                                                Binding="{Binding TermOneGradeText}"
                                                Width="0.8*"/>

                            <DataGridTextColumn Header="Term 2"
                                                Binding="{Binding TermTwoGradeText}"
                                                Width="0.8*"/>

                            <DataGridTextColumn Header="Term 3"
                                                Binding="{Binding TermThreeGradeText}"
                                                Width="0.8*"/>

                            <DataGridTextColumn Header="Final"
                                                Binding="{Binding FinalGradeText}"
                                                Width="0.8*"/>

                            <DataGridTextColumn Header="Descriptor"
                                                Binding="{Binding Descriptor}"
                                                Width="1.1*"/>

                            <DataGridTextColumn Header="Remarks"
                                                Binding="{Binding Remarks}"
                                                Width="0.9*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid ItemsSource="{Binding DescriptiveRows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="40"
                              ColumnHeaderHeight="42" MinHeight="300"
                              AlternatingRowBackground="#F8FAFC"
                              BorderBrush="{StaticResource BorderBrush}"
                              FontSize="11">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDescriptiveClass}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45"/>
                            <DataGridTextColumn Header="Learner Name" Binding="{Binding LearnerName}" Width="2.3*"/>
                            <DataGridTextColumn Header="Sex" Binding="{Binding Sex}" Width="0.7*"/>
                            <DataGridTextColumn Header="Term 1" Binding="{Binding TermOne}" Width="1*"/>
                            <DataGridTextColumn Header="Term 2" Binding="{Binding TermTwo}" Width="1*"/>
                            <DataGridTextColumn Header="Term 3" Binding="{Binding TermThree}" Width="1*"/>
                            <DataGridTextColumn Header="Record Status" Binding="{Binding Status}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <!-- Class consolidated grades -->
            <Border Grid.Row="4" Margin="0,6,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDescriptiveClass}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Class Consolidated Grades"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="Bold"/>

                            <TextBlock Text="Final grades in all assigned subjects with automatic general average and remarks."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
            Content="Load Consolidated Grades"
            Command="{Binding LoadConsolidatedGradesCommand}"
            Style="{StaticResource PrimaryButtonStyle}"
            MinWidth="190"
            VerticalAlignment="Center"/>

                        <Button Grid.Column="3"
            Content="Export to PDF"
            Command="{Binding ExportConsolidatedGradesCommand}"
            Style="{StaticResource SecondaryButtonStyle}"
            MinWidth="140"
            VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Consolidated summary -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                            <StackPanel>
                                <TextBlock Text="SUBJECTS"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9"
                               FontWeight="Bold"/>

                                <TextBlock Text="{Binding ConsolidatedSubjectCount}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                            <StackPanel>
                                <TextBlock Text="COMPLETE"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9"
                               FontWeight="Bold"/>

                                <TextBlock Text="{Binding ConsolidatedCompleteLearners}"
                               Foreground="#2563EB"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                            <StackPanel>
                                <TextBlock Text="PASSED"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9"
                               FontWeight="Bold"/>

                                <TextBlock Text="{Binding ConsolidatedPassedLearners}"
                               Foreground="#16A34A"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                            <StackPanel>
                                <TextBlock Text="NEEDS SUPPORT"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9"
                               FontWeight="Bold"/>

                                <TextBlock Text="{Binding ConsolidatedNeedsSupport}"
                               Foreground="#DC2626"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="8"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                            <StackPanel>
                                <TextBlock Text="CLASS AVERAGE"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9"
                               FontWeight="Bold"/>

                                <TextBlock Text="{Binding ConsolidatedClassAverageText}"
                               Foreground="#D97706"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="11,8"
                Margin="0,0,0,14">

                        <TextBlock Text="General Average is shown only when all assigned numerical subjects have complete Term 1, Term 2, and Term 3 grades."
                       Foreground="#1E40AF"
                       FontSize="10"
                       TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid ItemsSource="{Binding ConsolidatedGradesView}"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F8FAFC"
                  AlternationCount="2"
                  RowHeight="40"
                  ColumnHeaderHeight="42"
                 ColumnWidth="Auto"
                    MinColumnWidth="55"
                    MaxColumnWidth="220"
                  MinHeight="380"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

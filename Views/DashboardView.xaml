<UserControl x:Class="TeachFlex.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Welcome and clock -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Welcome back,"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"/>

                    <TextBlock Text="{Binding TeacherName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>

                    <TextBlock Text="Here is your teaching overview for today."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Padding="22,14">

                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentTime}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding CurrentDate}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Teacher and school profile -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="64"
                            Height="64"
                            Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="32">

                        <Grid>
                            <TextBlock Text="🏫"
               FontFamily="Segoe UI Emoji"
               FontSize="28"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

                            <Image Source="{Binding SchoolLogoPath}"
           Stretch="Uniform"
           Margin="7"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,20,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding SchoolName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0">

                            <TextBlock Text="{Binding SchoolId}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>

                            <TextBlock Text="  •  "
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Text="{Binding SchoolYear}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>

                            <TextBlock Text="  •  "
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <ComboBox ItemsSource="{Binding AvailableGradeLevels}"
                                      SelectedItem="{Binding SelectedGradeLevel, Mode=TwoWay}"
                                      MinWidth="105" MaxWidth="150" Height="32"
                                      Padding="8,2" FontSize="12"
                                      ToolTip="Filter classes by grade level"/>

                            <TextBlock Text="  •  "
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <ComboBox ItemsSource="{Binding AvailableClasses}"
          SelectedItem="{Binding SelectedClassOption,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged}"
          DisplayMemberPath="DisplayName"
          MinWidth="170"
          MaxWidth="260"
          Height="32"
          Padding="8,2"
          FontSize="12"
          Foreground="{StaticResource TextPrimaryBrush}"
          VerticalAlignment="Center"
          ToolTip="Select the class to display on the Dashboard"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="8"
                            Padding="12,7"
                            VerticalAlignment="Center">

                        <TextBlock Text="OFFLINE READY"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Statistics -->
            <UniformGrid Grid.Row="3"
                         Columns="3"
                         Margin="0,0,0,20">

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,10,10">

                    <StackPanel>
                        <TextBlock Text="TOTAL LEARNERS"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding NumberOfLearners}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding ClassRoleText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,10,10">

                    <StackPanel>
                        <TextBlock Text="MALE LEARNERS"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding MaleLearners}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Current class count"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="FEMALE LEARNERS"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding FemaleLearners}"
                                   Foreground="#A855F7"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Current class count"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="PRESENT TODAY"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding PresentTodayText}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Based on today's attendance"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="ABSENT TODAY"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding AbsentTodayText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Based on today's attendance"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>
                        <TextBlock Text="CLASS PERFORMANCE"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding AverageClassPerformance}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Average performance rating"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Performance and activities -->
            <Grid Grid.Row="4"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Class Performance"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Performance charts will appear when grade records are available."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,18"/>

                        <Border Height="160"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="▥"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="30"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="No grade records yet"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Margin="10,0,0,0">

                    <StackPanel>
                        <TextBlock Text="Reading Performance"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReadingPerformance}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,18"/>

                        <Border Height="160"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="📖"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="30"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Reading data will appear here"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick actions: placed near the top for faster access -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,12">

                <StackPanel>
                    <TextBlock Text="Quick Actions"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="17"
                               FontWeight="Bold"/>

                    <TextBlock Text="Frequently used TeachFlex tools"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,4,0,16"/>

                    <UniformGrid Columns="4">

                        <Button Content="＋  Add Learner"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="Learners"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,8"/>

                        <Button Content="✓  Take Attendance"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="Attendance"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,8,8"/>

                        <Button Content="▦  Encode Grades"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="Grades"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,8,8"/>

                        <Button Content="▤  Open ECR"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="ECR"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,8"/>

                        <Button Content="✎  Lesson Plan"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="LessonPlanner"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,8,8,0"/>

                        <Button Content="▧  Activity Sheet"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="ActivitySheet"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,8,8,0"/>

                        <Button Content="?  Assessment"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="Assessment"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,8,8,0"/>

                        <Button Content="▶  Generate PPT"
                                Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="PPTGenerator"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,8,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

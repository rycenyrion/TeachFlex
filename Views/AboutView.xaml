<UserControl x:Class="TeachFlex.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeachFlex.ViewModels">
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28">
                <Border MaxWidth="900"
                        Padding="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center">
                            <Border Width="118"
                                    Height="118"
                                    Padding="4"
                                    CornerRadius="22"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Image Source="pack://application:,,,/Assets/Images/TeachFlexLogo.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="{Binding ApplicationName}"
                                       Margin="0,18,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="30"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Tagline}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,24,0,0"
                                   MaxWidth="650"
                                   HorizontalAlignment="Center"
                                   Text="{Binding Description}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   LineHeight="22"/>
                        <Border Grid.Row="2"
                                Margin="0,26,0,0"
                                Padding="20"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="VERSION"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Version}"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="PLATFORM"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Platform}"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="3"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Developer}"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Copyright}"
                                       Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="OFFICIAL REPOSITORY"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="13">
                                <Hyperlink NavigateUri="{Binding RepositoryUrl}"
                                           RequestNavigate="RepositoryLink_RequestNavigate"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    github.com/rycenyrion/TeachFlex
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
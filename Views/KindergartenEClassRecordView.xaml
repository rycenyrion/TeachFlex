<UserControl x:Class="TeachFlex.Views.KindergartenEClassRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource CardStyle}"
            Margin="0,0,0,16">

        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Kindergarten E-Class Record"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Official three-term competency record using BG, DV, and CO ratings."
                   Margin="0,5,0,0"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding StatusMessage}"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                    <Button Content="Reload Record"
                Command="{Binding ReloadGuardedKindergartenRecordCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                MinWidth="125"
                Height="40"
                Margin="0,0,10,0"/>

                    <Button Content="Save Kinder Record"
                Command="{Binding SaveValidatedKindergartenRecordCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                MinWidth="150"
                Height="40"
                Margin="0,0,10,0"/>


                    <Button Content="Export PDF"
                Command="{Binding ExportValidatedKindergartenPdfCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                MinWidth="115"
                Height="40"/>
                </StackPanel>
            </Grid>

            <!-- Rating guide -->
            <Border Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="Kinder Rating Guide"
                               FontWeight="Bold"
                               Foreground="#1D4ED8"/>

                    <TextBlock Margin="0,5,0,0"
                               Foreground="#475569"
                               FontSize="12"
                               TextWrapping="Wrap">

                        <Run Text="BG"/>
                        <Run Text=" — Beginning     "/>
                        <Run Text="DV"/>
                        <Run Text=" — Developing     "/>
                        <Run Text="CO"/>
                        <Run Text=" — Consistent"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Completion status -->
            <Border Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Rating Completion"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Blank ratings are highlighted. Complete every competency before exporting the PDF."
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="14,7"
                            CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF3C7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKindergartenRatingComplete}"
                                                 Value="True">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding KindergartenCompletionText}"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Learners and competency checklist -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Learner selector -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10">

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Kindergarten Learners"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="4,2,4,10"/>

                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="4,10,4,2">
                            <TextBlock Text="{Binding KindergartenLearnerPositionText}"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       Margin="0,0,0,7"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Previous"
                                        Command="{Binding MoveToPreviousKindergartenLearnerCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="38"/>

                                <Button Grid.Column="2"
                                        Content="Next"
                                        Command="{Binding MoveToNextKindergartenLearnerCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="38"/>
                            </Grid>

                            <TextBlock Text="Select a learner to enter or review the selected term ratings."
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,7,0,0"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding KindergartenLearners}"
                                 SelectedItem="{Binding GuardedSelectedKindergartenLearner,
                                                        Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="610"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Margin"
                                            Value="0,0,0,6"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="7">

                                        <StackPanel>
                                            <TextBlock Text="{Binding OfficialName}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,4,0,0">

                                                <TextBlock Text="{Binding Lrn}"
                                                           FontSize="10"
                                                           Foreground="#64748B"/>

                                                <TextBlock Text="  •  "
                                                           FontSize="10"
                                                           Foreground="#94A3B8"/>

                                                <TextBlock Text="{Binding Sex}"
                                                           FontSize="10"
                                                           Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Competency checklist -->
                <Border Grid.Column="2"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="9"
                        Background="White">

                    <DataGrid ItemsSource="{Binding KindergartenRatingRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              MinHeight="610"
                              MaxHeight="610"
                              IsReadOnly="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Development Area"
                                                Binding="{Binding DevelopmentArea}"
                                                Width="180"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Sub-domain"
                                                Binding="{Binding SubDomain}"
                                                Width="165"
                                                IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Competency"
                                                    Width="*"
                                                    MinWidth="300">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayDescription}"
                                                   TextWrapping="Wrap"
                                                   Margin="6"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Rating"
                                                    Width="95">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.KindergartenRatingOptions,
                                                                       RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding Rating,
                                                                         Mode=TwoWay,
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="32"
                                                  Margin="4"
                                                  HorizontalContentAlignment="Center">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rating}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Background" Value="#FFF1F2"/>
                                                            <Setter Property="BorderBrush" Value="#FB7185"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Rating}"
                                                                     Value="">
                                                            <Setter Property="Background" Value="#FFF1F2"/>
                                                            <Setter Property="BorderBrush" Value="#FB7185"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Observation"
                                                    Width="220">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Observation,
                                                               Mode=TwoWay,
                                                               UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="34"
                                                 Margin="4"
                                                 VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Teacher comments -->
            <Border Margin="0,18,0,0"
                    Padding="14"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="9">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Teacher’s Comments and Remarks"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Suggest Remarks"
                                Command="{Binding GenerateKindergartenRemarksCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="145"
                                Height="40"/>
                    </Grid>

                    <TextBlock Text="Provide specific observations, strengths, and suggested interventions for the selected learner and term."
                               Margin="0,4,0,12"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Unsaved changes"
                               Margin="0,0,0,10"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#B45309">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedKindergartenChanges}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Specific Observations"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <TextBox Text="{Binding KindergartenTeacherComment,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="110"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Learner Strengths"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <TextBox Text="{Binding KindergartenLearnerStrengths,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="110"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Suggested Interventions"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <TextBox Text="{Binding KindergartenSuggestedInterventions,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="110"
                                     Padding="8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>

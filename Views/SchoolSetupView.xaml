<UserControl x:Class="TeachFlex.Views.SchoolSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="FormTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="43"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Heading -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="School Setup"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Configure the centralized school information used throughout TeachFlex."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="9"
                        Padding="14,9"
                        VerticalAlignment="Center">

                    <TextBlock Text="CENTRALIZED SCHOOL DATA"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- Information card -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}">

                <StackPanel>
                    <TextBlock Text="School Information"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="Fields marked with * are required."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,4,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- School Name -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">

                            <TextBlock Text="School Name *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding SchoolName,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MaxLength="200"/>
                        </StackPanel>

                        <!-- School ID -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">

                            <TextBlock Text="School ID *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding SchoolId,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MaxLength="30"/>
                        </StackPanel>

                        <!-- Region -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">

                            <TextBlock Text="Region"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding Region,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MaxLength="100"/>
                        </StackPanel>

                        <!-- Division -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">

                            <TextBlock Text="Schools Division Office"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding Division,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MaxLength="150"/>
                        </StackPanel>

                        <!-- District -->
                        <StackPanel Grid.Row="4"
                                    Grid.Column="0">

                            <TextBlock Text="District"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding District,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MaxLength="150"/>
                        </StackPanel>

                        <!-- Classification -->
                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <TextBlock Text="School Classification"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <ComboBox Height="43"
                                      Padding="10,7"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding SchoolClassification}">

                                <ComboBoxItem Content="Public School"/>
                                <ComboBoxItem Content="Private School"/>
                                <ComboBoxItem Content="Integrated School"/>
                                <ComboBoxItem Content="Laboratory School"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Address -->
                        <StackPanel Grid.Row="6"
                                    Grid.Column="0">

                            <TextBlock Text="School Address"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding SchoolAddress,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MaxLength="250"/>
                        </StackPanel>

                        <!-- School Head -->
                        <StackPanel Grid.Row="6"
                                    Grid.Column="2">

                            <TextBlock Text="School Head"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding SchoolHead,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MaxLength="150"/>
                        </StackPanel>
                    </Grid>

                    <!-- Action bar -->
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="110"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Save School Information"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="190"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Official logos -->
            <Border Grid.Row="2"
        Style="{StaticResource CardStyle}"
        Margin="0,18,0,0">

                <StackPanel>
                    <TextBlock Text="Official Logos"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="Bold"/>

                    <TextBlock Text="Upload the logos used in official reports and School Forms."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   Margin="0,4,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DepEd Logo -->
                        <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="96"
                            Height="96"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                                    <Image Source="{Binding DepEdLogoPath}"
                               Stretch="Uniform"
                               Margin="7"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                                    <TextBlock Text="DepEd Logo"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                                    <TextBlock Text="Used on prescribed forms and official reports."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,12"/>

                                    <Button Content="Select DepEd Logo"
                                Command="{Binding SelectDepEdLogoCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="150"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- School Logo -->
                        <Border Grid.Column="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="96"
                            Height="96"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                                    <Image Source="{Binding SchoolLogoPath}"
                               Stretch="Uniform"
                               Margin="7"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                                    <TextBlock Text="School Logo"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                                    <TextBlock Text="Used beside the DepEd logo in school documents."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,12"/>

                                    <Button Content="Choose / Change School Logo"
                                Command="{Binding SelectSchoolLogoCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="150"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Teacher information -->
            <Border Grid.Row="3"
        Style="{StaticResource CardStyle}"
        Margin="0,18,0,0">

                <StackPanel>
                    <TextBlock Text="Teacher Information"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="Bold"/>

                    <TextBlock Text="Manage the teacher profile and professional information used by the Dashboard, classes, reports, and School Forms."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   Margin="0,4,0,20"/>

                    <!-- Profile picture and basic information -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Profile picture -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Profile Picture"
                           Style="{StaticResource FormLabelStyle}"
                           HorizontalAlignment="Center"/>

                            <Border Width="132"
                        Height="132"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="66"
                        ClipToBounds="True">

                                <Grid>
                                    <TextBlock Text="PHOTO"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                                    <Image Source="{Binding ProfileImagePath}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <Button Content="Choose Picture"
                        Command="{Binding SelectTeacherProfileImageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Basic teacher information -->
                        <StackPanel Grid.Column="2">
                            <!-- Name row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="First Name *"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <TextBox Text="{Binding TeacherFirstName,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Middle Name"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <TextBox Text="{Binding TeacherMiddleName,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Last Name *"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <TextBox Text="{Binding TeacherLastName,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Employment row -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.65*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Suffix"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <TextBox Text="{Binding TeacherSuffix,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="20"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Position"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <ComboBox ItemsSource="{Binding TeacherPositions}"
                                  SelectedItem="{Binding TeacherPosition}"
                                  Height="43"
                                  Padding="10,7"
                                  FontSize="13"
                                  Background="White"
                                  BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Employee Number"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <TextBox Text="{Binding EmployeeNumber,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="50"/>
                                </StackPanel>
                            </Grid>

                            <!-- Contact row -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DepEd Email"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <TextBox Text="{Binding EmailAddress,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="150"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Contact Number"
                                   Style="{StaticResource FormLabelStyle}"/>

                                    <TextBox Text="{Binding ContactNumber,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="30"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Government information -->
                    <Border Height="1"
                Background="{StaticResource BorderBrush}"
                Margin="0,24,0,20"/>

                    <TextBlock Text="Government Identification Numbers"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="14"
                   FontWeight="Bold"/>

                    <TextBlock Text="These fields are optional and will be stored with the teacher profile."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="10"
                   Margin="0,3,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Pag-IBIG Number"
                           Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding PagIbigNumber,
                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MaxLength="50"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UMID Number"
                           Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding UmidNumber,
                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MaxLength="50"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SSS Number"
                           Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding SssNumber,
                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MaxLength="50"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="PhilHealth Number"
                           Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Text="{Binding PhilHealthNumber,
                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MaxLength="50"/>
                        </StackPanel>
                    </Grid>

                    <!-- Save action -->
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Save School Information first before saving a new teacher profile."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"/>

                            <TextBlock Text="Personal identification numbers are not displayed on the Dashboard."
                           Foreground="#B45309"
                           FontSize="10"
                           Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                    Content="Save Teacher Information"
                    Command="{Binding SaveTeacherCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="190"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
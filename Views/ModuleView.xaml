<UserControl x:Class="TeachFlex.Views.ModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">
        <Border Style="{StaticResource CardStyle}"
                MaxWidth="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="42">

            <StackPanel>
                <Border Width="76"
                        Height="76"
                        Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="38"
                        HorizontalAlignment="Center">

                    <TextBlock Text="▦"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="28"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,22,0,0"/>

                <TextBlock Text="{Binding Description}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Margin="0,12,0,0"/>

                <Border Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8"
                        Padding="14,8"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center">

                    <TextBlock Text="{Binding DevelopmentPhase}"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="This module will be activated when its development phase begins."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
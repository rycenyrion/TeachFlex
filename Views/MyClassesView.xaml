<UserControl x:Class="TeachFlex.Views.MyClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="ClassFieldStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="11,7"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="ClassLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="My Classes"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Create school years and manage advisory classes."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="110"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- School Year -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current School Year"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Select the school year used by classes and learner records."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,13"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox ItemsSource="{Binding AcademicYears}"
                                      SelectedItem="{Binding SelectedAcademicYear}"
                                      DisplayMemberPath="DisplayName"
                                      Height="42"
                                      Padding="10,7"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"/>

                            <Button Grid.Column="2"
                                    Content="Use Selected School Year"
                                    Command="{Binding UseSelectedSchoolYearCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="175"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">

                        <StackPanel>
                            <TextBlock Text="Create School Year"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding SchoolYearStart,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ClassFieldStyle}"
                                         ToolTip="Starting year"/>

                                <TextBlock Grid.Column="1"
                                           Text="-"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Column="2"
                                         Text="{Binding SchoolYearEnd,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ClassFieldStyle}"
                                         ToolTip="Ending year"/>

                                <Button Grid.Column="4"
                                        Content="Create"
                                        Command="{Binding CreateSchoolYearCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="90"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Class editor -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Class Information"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Select a record below to edit it, or click New Class."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="＋ New Class"
                                Command="{Binding NewClassCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="120"/>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Grade Level *"
                                       Style="{StaticResource ClassLabelStyle}"/>

                            <ComboBox ItemsSource="{Binding GradeLevels}"
                                      SelectedItem="{Binding GradeLevel}"
                                      Height="42"
                                      Padding="10,7"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Section Name *"
                                       Style="{StaticResource ClassLabelStyle}"/>

                            <TextBox Text="{Binding SectionName,
                                              UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassFieldStyle}"
                                     MaxLength="100"/>
                        </StackPanel>



                    </Grid>

                    <!-- Senior High Track / Strand -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,16,0,0">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeniorHigh}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="Senior High School Track / Strand *"
                                       Style="{StaticResource ClassLabelStyle}"/>

                            <ComboBox ItemsSource="{Binding TrackStrandOptions}"
                                      SelectedItem="{Binding TrackStrand}"
                                      Height="42"
                                      Padding="10,7"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Remove Class"
                                Command="{Binding DeleteClassCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="120"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Save Class"
                                Command="{Binding SaveClassCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="130"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Class list -->
            <Border Grid.Row="3"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,12">

                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Class Records"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8"
                                Padding="11,6">

                            <TextBlock
                                Text="{Binding Classes.Count,
                                    StringFormat={}{0} CLASS(ES)}"
                                Foreground="{StaticResource PrimaryDarkBrush}"
                                FontSize="10"
                                FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Classes}"
                              SelectedItem="{Binding SelectedClass}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="42"
                              ColumnHeaderHeight="40"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              Background="White"
                              AlternatingRowBackground="#F8FAFC">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Grade Level"
                                Binding="{Binding GradeLevel}"
                                Width="1.1*"/>

                            <DataGridTextColumn
                                Header="Section"
                                Binding="{Binding SectionName}"
                                Width="1.3*"/>

                            <DataGridTextColumn
                                Header="Key Stage"
                                Binding="{Binding KeyStage}"
                                Width="1.1*"/>

                            <DataGridTextColumn
                                Header="Track / Strand"
                                Binding="{Binding TrackStrand}"
                                Width="1.2*"/>


                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Class subject list -->
            <Border Grid.Row="4"
                    Style="{StaticResource CardStyle}"
                    Margin="0,6,0,12">

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Class Subjects"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock
                                Text="Select a class from the table above to view its automatically assigned subjects."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="11"
                                Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#F0FDF4"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,6"
                                VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding ClassSubjects.Count,
                                    StringFormat={}{0} SUBJECT(S)}"
                                Foreground="#166534"
                                FontSize="10"
                                FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ClassSubjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PrimaryLightBrush}"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="14,10"
                                        Margin="0,0,10,10"
                                        MinWidth="190">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="24"
                                                Height="24"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="12">

                                            <TextBlock Text="{Binding DisplayOrder}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="9,0,0,0">

                                            <TextBlock Text="{Binding SubjectName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

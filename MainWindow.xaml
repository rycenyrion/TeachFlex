<Window x:Class="TeachFlex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TeachFlex.Converters"
        xmlns:viewModels="clr-namespace:TeachFlex.ViewModels"
        xmlns:views="clr-namespace:TeachFlex.Views"
        Title="TeachFlex — One System, Every Classroom"
        Width="1100"
        Height="680"
        MinWidth="1100"
        MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:BackupRestoreViewModel}">
            <views:BackupRestoreView/>
        </DataTemplate>

        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>

        <converters:NavigationSelectionConverter
            x:Key="NavigationSelectionConverter"/>

        <Style x:Key="ActiveSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">

            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding
                            Converter="{StaticResource NavigationSelectionConverter}">

                            <Binding RelativeSource="{RelativeSource Self}"
                                     Path="Tag"/>

                            <Binding RelativeSource="{RelativeSource AncestorType=Window}"
                                     Path="DataContext.CurrentPageKey"/>
                        </MultiBinding>
                    </DataTrigger.Binding>

                    <Setter Property="Background"
                            Value="{StaticResource PrimaryBrush}"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="{Binding SidebarWidth}"/>

            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <Grid Grid.Row="0"
                      Margin="14,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="58"
                                Height="58"
                                Background="Transparent"
                                CornerRadius="10"
                                ClipToBounds="True">

                            <Image Source="pack://application:,,,/Assets/Images/TeachFlexLogo.png"
                                Stretch="Uniform"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                            <TextBlock Text="TeachFlex"
                                      Foreground="#163A24"
                                       FontSize="20"
                                       FontWeight="Bold"/>

                            <TextBlock Text="One System, Every Classroom"
                                       Foreground="#52705C"
                                       FontSize="9"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="34"
                            Height="34"
                            Content="☰"
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent"
                           Foreground="#163A24"
                            BorderThickness="0"
                            FontSize="17"
                            Cursor="Hand"
                            ToolTip="Collapse or expand sidebar"/>
                </Grid>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,4,0,12">

                        <TextBlock Text="MAIN"
                                   Foreground="#64748B"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="22,8,0,7"
                                   Visibility="{Binding IsSidebarExpanded,
                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="Dashboard"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Dashboard">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂"
                                           Width="32"
                                           FontSize="19"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Dashboard"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="MyClasses"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="MyClasses"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="My Classes">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="My Classes"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="SubjectSetup"
        Command="{Binding NavigateCommand}"
        CommandParameter="SubjectSetup"
        Style="{StaticResource ActiveSidebarButtonStyle}"
        ToolTip="Subject Setup">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤"
                   Width="32"
                   FontSize="17"
                   Foreground="{Binding Foreground,
                       RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Subject Setup"
                   VerticalAlignment="Center"
                   Visibility="{Binding DataContext.IsSidebarExpanded,
                       RelativeSource={RelativeSource AncestorType=Window},
                       Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="Learners"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Learners"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Learners">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♙"
                                           Width="32"
                                           FontSize="18"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Learners"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="Attendance"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Attendance"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Attendance">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Attendance"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="ECR"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="ECR"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Electronic Class Record">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Electronic Class Record"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="Grades"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Grades"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Grades">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▥"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Grades"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="SFForms"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="SFForms"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="SF Forms">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▧"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="SF Forms"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="TEACHING TOOLS"
                                   Foreground="#64748B"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="22,18,0,7"
                                   Visibility="{Binding IsSidebarExpanded,
                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="LessonPlanner"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="LessonPlanner"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Lesson Planner">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✎"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Lesson Planner"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="MANAGEMENT"
                                   Foreground="#64748B"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="22,18,0,7"
                                   Visibility="{Binding IsSidebarExpanded,
                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="Reports"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Reports"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Reports">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▥"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Reports"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="FileManager"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="FileManager"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="File Manager">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="File Manager"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="Update"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Update"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="UPDATE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻"
                                           Width="32"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="UPDATE"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="Settings"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Settings"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Settings">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Settings"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>


                        <Button Tag="Themes"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Themes"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Themes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◐"
                                           Width="32"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Themes"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="BackupRestore"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="BackupRestore"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="Backup &amp; Restore">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻"
                                           Width="32"
                                           FontSize="19"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Backup &amp; Restore"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="About"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="About"
                                Style="{StaticResource ActiveSidebarButtonStyle}"
                                ToolTip="About TeachFlex">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ⓘ"
                                           Width="32"
                                           FontSize="17"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="About TeachFlex"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar footer -->
                <Border Grid.Row="2"
                        BorderBrush="#C6DFC9"
                        BorderThickness="0,1,0,0"
                        Padding="18,14">

                    <StackPanel
                        Visibility="{Binding IsSidebarExpanded,
                            Converter={StaticResource BooleanToVisibilityConverter}}">

                        <TextBlock Text="TeachFlex"
           Foreground="#163A24"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Offline-first Windows Desktop"
                                   Foreground="#52705C"
                                   FontSize="9"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top toolbar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="21"
                                   FontWeight="Bold"/>

                        <TextBlock Text="TeachFlex workspace"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Background="#E9F7EE"
                                BorderBrush="#9ED4AE"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,7"
                                Margin="0,0,18,0">

                            <TextBlock Text="{Binding ActiveSchoolYearText}"
                                       Foreground="#166534"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="ZOOM"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>

                        <Button Content="−"
                                Command="{Binding ZoomOutCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Zoom out"/>

                        <Button Content="{Binding ZoomText}"
                                Command="{Binding ResetZoomCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="68"
                                FontSize="11"
                                Margin="7,0"
                                ToolTip="Reset zoom"/>

                        <Button Content="+"
                                Command="{Binding ZoomInCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Zoom in"/>

                        <Border Width="1"
                                Height="28"
                                Background="{StaticResource BorderBrush}"
                                Margin="16,0"/>

                        <Grid>
                            <ToggleButton x:Name="TeacherProfileButton"
                  Width="38"
                  Height="38"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  ToolTip="Open teacher profile">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Grid>
                                            <Ellipse Fill="{StaticResource PrimaryLightBrush}"/>

                                            <TextBlock Text="{Binding TeacherInitials}"
               Foreground="{StaticResource PrimaryDarkBrush}"
               FontSize="13"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding TeacherProfileImagePath}"
                        Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding ElementName=TeacherProfileButton}"
           Placement="Bottom"
           HorizontalOffset="-255"
           VerticalOffset="10"
           IsOpen="{Binding IsChecked,
                            ElementName=TeacherProfileButton,
                            Mode=TwoWay}"
           StaysOpen="False"
           AllowsTransparency="True">

                                <Border Width="295"
                Padding="18"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.18"
                                  Color="#334155"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="50"
      Height="50">

                                                <Ellipse Fill="{StaticResource PrimaryLightBrush}"/>

                                                <TextBlock Text="{Binding TeacherInitials}"
               Foreground="{StaticResource PrimaryDarkBrush}"
               FontSize="16"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding TeacherProfileImagePath}"
                        Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>

                                            <StackPanel Margin="12,2,0,0"
                                Width="195">
                                                <TextBlock Text="{Binding TeacherDisplayName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding TeacherPosition}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,15"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Employee No."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"/>

                                            <TextBlock Grid.Column="1"
                               Text="{Binding TeacherEmployeeNumber}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="School"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"/>

                                            <TextBlock Grid.Column="1"
                               Text="{Binding TeacherSchoolName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                                        </Grid>

                                        <Border Background="#FFF7D6"
                        BorderBrush="#F3D878"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="9,6"
                        Margin="0,0,0,12">

                                            <TextBlock Text="Account access: Standby"
                               Foreground="#7A5A00"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                                        </Border>

                                        <Button Content="Edit Teacher Profile"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Settings"
                        Height="34"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Current page -->
            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundBrush}"
                    ClipToBounds="True">

                <ContentControl Content="{Binding CurrentViewModel}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                    <ContentControl.LayoutTransform>
                        <ScaleTransform
                            ScaleX="{Binding ZoomScale}"
                            ScaleY="{Binding ZoomScale}"/>
                    </ContentControl.LayoutTransform>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
<Application x:Class="TeachFlex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TeachFlex.ViewModels"
             xmlns:views="clr-namespace:TeachFlex.Views">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="/Resources/Themes/Colors.xaml"/>

                <ResourceDictionary
                    Source="/Resources/Styles/Controls.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!-- Automatic ViewModel-to-View mapping -->

            <DataTemplate
                DataType="{x:Type viewModels:DashboardViewModel}">

                <views:DashboardView/>
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type viewModels:ModuleViewModel}">

                <views:ModuleView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ThemesViewModel}">
                <views:ThemesView/>
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type viewModels:SchoolSetupViewModel}">

                <views:SchoolSetupView/>
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type viewModels:MyClassesViewModel}">

                <views:MyClassesView/>
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type viewModels:LearnersViewModel}">

                <views:LearnersView/>
            </DataTemplate>
            <DataTemplate
    DataType="{x:Type viewModels:EClassRecordViewModel}">

                <views:EClassRecordView/>
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type viewModels:SubjectSetupViewModel}">

                <views:SubjectSetupView/>
            </DataTemplate>
            <DataTemplate
    DataType="{x:Type viewModels:AttendanceViewModel}">

                <views:AttendanceView/>
            </DataTemplate>
            <DataTemplate
    DataType="{x:Type viewModels:GradesViewModel}">

                <views:GradesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LessonPlannerViewModel}">
                <views:LessonPlannerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ActivitySheetViewModel}">
                <views:ActivitySheetView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ReadingTrackerViewModel}">
                <views:ReadingTrackerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
                <views:ReportsView/>
            </DataTemplate>
            <DataTemplate
    DataType="{x:Type viewModels:SchoolFormsViewModel}">

                <views:SchoolFormsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>

</Application>
